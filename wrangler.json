{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-web",
  "main": "src/index.js",
  "compatibility_date": "2024-04-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SYNTHETIX_KV",
      "id": "f03b18c3a2cf444f97cac17eeb8ee4d8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SYNTHETIX_BUCKET",
      "bucket_name": "synthetix-vault"
    }
  ]
}
